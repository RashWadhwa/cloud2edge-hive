# Non-secret settings. Run ./scripts/edge init before editing .edge/config.env.
# Copy the Arduino entry only, not the SONOFF entry or the -> tty target.
ARDUINO_DEVICE=
ARDUINO_GID=20
SERIAL_BAUD=9600
SENSOR_ID=arduino-bme280-01
LOCATION=indoor
# Approximate Wolverhampton town centre. No Open-Meteo API key required
# for its public non-commercial endpoint; see docs/PROJECT.md for terms.
WEATHER_ENABLED=true
WEATHER_LATITUDE=52.587
WEATHER_LONGITUDE=-2.129
WEATHER_LOCATION=wolverhampton
# Use the Pi's LAN/hotspot IP to expose Grafana; default is local-machine only.
# Reissue the certificate with that IP before changing this setting.
EDGE_BIND=127.0.0.1
