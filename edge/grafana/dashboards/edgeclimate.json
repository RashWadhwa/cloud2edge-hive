  "panels": [
    {
      "id": 1,
      "title": "Indoor reading age \u2014 seconds",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "edge-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"environment\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"temperature\" and r.source == \"bme280\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
