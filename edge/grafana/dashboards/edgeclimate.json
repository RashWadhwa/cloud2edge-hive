{
  "uid": "edgeclimate",
  "title": "EdgeClimate \u2014 Secure Offline Environmental Observatory",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-6h",
