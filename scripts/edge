#!/usr/bin/env python3
"""Local project commands. Never pushes Git changes or prints credentials."""
import argparse
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import secrets
import stat
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
PRIVATE = ROOT / ".edge"


def run(*args, **kwargs):
    return subprocess.run(args, check=True, cwd=ROOT, **kwargs)


def config():
    return dict(line.split("=", 1) for line in (PRIVATE / "config.env").read_text().splitlines()
                if line.strip() and not line.lstrip().startswith("#"))


def write_config(values):
    path = PRIVATE / "config.env"
    old = path.read_text().splitlines()
    found = set()
    for index, line in enumerate(old):
        key = line.split("=", 1)[0]
        if key in values:
            old[index] = key + "=" + str(values[key])
            found.add(key)
    old.extend(key + "=" + str(value) for key, value in values.items() if key not in found)
    path.write_text("\n".join(old) + "\n")


def compose(*args, **kwargs):
    return run("docker", "compose", "--env-file", str(PRIVATE / "config.env"),
               "-f", "compose.edge.yml", *args, **kwargs)


def create_secret(name, value=None):
    path = PRIVATE / "secrets" / name
    if not path.exists():
        path.write_text((secrets.token_urlsafe(36) if value is None else value) + "\n")
        path.chmod(0o600)


def certificate(host):
    tls = PRIVATE / "tls"
    tls.mkdir(mode=0o700, exist_ok=True)
    # host is used only as a validated DNS/IP SAN; never in shell code.
    try:
        ipaddress.ip_address(host)
        san = "IP:" + host
    except ValueError:
        import re
        if not re.fullmatch(r"[a-zA-Z0-9](?:[a-zA-Z0-9.-]{0,251}[a-zA-Z0-9])?", host):
            raise ValueError("Supply an IP address or DNS hostname")
        san = "DNS:" + host
    if not (tls / "ca.key").exists():
        run("openssl", "req", "-x509", "-newkey", "rsa:3072", "-nodes", "-days", "3650",
            "-keyout", str(tls / "ca.key"), "-out", str(tls / "ca.crt"),
            "-subj", "/CN=EdgeClimate Local CA", stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    ext = tls / "server.ext"
    ext.write_text("subjectAltName=DNS:localhost,DNS:grafana,IP:127.0.0.1," + san +
                   "\nbasicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\n")
    run("openssl", "req", "-new", "-newkey", "rsa:2048", "-nodes", "-keyout", str(tls / "server.key"),
        "-out", str(tls / "server.csr"), "-subj", "/CN=EdgeClimate", stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    run("openssl", "x509", "-req", "-in", str(tls / "server.csr"), "-CA", str(tls / "ca.crt"),
        "-CAkey", str(tls / "ca.key"), "-CAcreateserial", "-out", str(tls / "server.crt"),
        "-days", "365", "-extfile", str(ext), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for path in tls.iterdir():
        path.chmod(0o600 if path.suffix == ".key" else 0o644)
    print("Certificate issued. Trust .edge/tls/ca.crt on dashboard clients; never share ca.key.")


def init():
    os.umask(0o077)
    PRIVATE.mkdir(mode=0o700, exist_ok=True)
    (PRIVATE / "secrets").mkdir(mode=0o700, exist_ok=True)
    if not (PRIVATE / "config.env").exists():
        (PRIVATE / "config.env").write_text((ROOT / "edge/config.env.example").read_text())
        info = run("docker", "info", "--format", "{{json .SecurityOptions}}", capture_output=True, text=True)
        rootless = "rootless" in info.stdout
        write_config({"EDGE_UID": 0 if rootless else os.getuid(), "EDGE_GID": 0 if rootless else os.getgid()})
    for name in ("influx_admin_token", "influx_admin_password", "grafana_admin_password", "grafana_secret_key",
                 "ingest_token", "nodered_credential_key", "nodered_admin_password",
                 "viewer_password", "researcher_password"):
        create_secret(name)
    create_secret("influx_read_token", "")
    create_secret("influx_write_token", "")
    auth_path = PRIVATE / "secrets/nodered_auth.json"
    if not auth_path.exists():
        salt = secrets.token_hex(16)
        password = (PRIVATE / "secrets/nodered_admin_password").read_text().strip()
        auth_path.write_text(json.dumps({"salt": salt, "hash": hashlib.scrypt(
            password.encode(), salt=salt.encode(), n=16384, r=8, p=1, dklen=32).hex()}) + "\n")
    if not (PRIVATE / "tls/server.crt").exists():
        certificate("localhost")
    print("Private configuration prepared; existing settings and secrets preserved.")
    print("Edit .edge/config.env. Password files are in .edge/secrets; they are never printed automatically.")


def start(demo):
    cfg = config()
    if cfg.get("WEATHER_ENABLED") == "true":
        for name, limit in (("WEATHER_LATITUDE", 90), ("WEATHER_LONGITUDE", 180)):
            value = float(cfg.get(name) or "nan")
            if not -limit <= value <= limit:
                raise ValueError("Set a valid " + name + " or disable weather")
    if not demo:
        device = cfg.get("ARDUINO_DEVICE", "")
        if not device or not stat.S_ISCHR(os.stat(device).st_mode):
            raise ValueError("Set ARDUINO_DEVICE to the real Arduino serial character device")
        if "sonoff" in device.lower():
            raise ValueError("Select the Arduino, not the SONOFF Zigbee coordinator")
        write_config({"ARDUINO_GID": os.stat(device).st_gid})
    # Stop only the alternative collector belonging to this project.
    compose("--profile", "demo", "--profile", "hardware", "stop", "serial" if demo else "simulator")
    compose("--profile", "demo" if demo else "hardware", "up", "-d",
            "influxdb", "provision", "storage", "nodered", "grafana", "simulator" if demo else "serial")
    compose("run", "--rm", "--no-deps", "-T", "tools", "python", "/app/check.py", "users")
    print("Started. Grafana: HTTPS port 3443; Node-RED editor: localhost port 1880 only.")
    print("Node-RED on another computer: SSH tunnel, see docs/PROJECT.md. Simulator data is labelled simulated.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["init", "cert", "up", "demo", "down", "status", "logs", "users", "verify", "backup", "benchmark"])
    parser.add_argument("host", nargs="?", help="cert: IP or hostname to include")
    args = parser.parse_args()
    if args.command == "init":
        init()
    elif args.command == "cert":
        certificate(args.host or "localhost")
    elif args.command in ("up", "demo"):
        start(args.command == "demo")
    elif args.command == "status":
        compose("--profile", "demo", "--profile", "hardware", "ps", "-a")
    elif args.command == "logs":
        compose("--profile", "demo", "--profile", "hardware", "logs", "--tail=100")
    elif args.command == "down":
        compose("--profile", "demo", "--profile", "hardware", "down")
    elif args.command == "backup":
        print("Stopping this project for a consistent cold backup; it remains stopped until up/demo.")
        compose("--profile", "demo", "--profile", "hardware", "stop")
        compose("run", "--rm", "--no-deps", "-T", "tools", "python", "/app/check.py", "backup")
    else:
        compose("run", "--rm", "--no-deps", "-T", "tools", "python", "/app/check.py", args.command)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        raise SystemExit("EdgeClimate command failed: " + str(error)) from None
